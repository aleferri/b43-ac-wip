From 51b7744f7dafab166f11c788b1628add0d584566 Mon Sep 17 00:00:00 2001
From: Alessandro Ferri <aleferri@example.invalid>
Date: Mon, 28 Sep 2026 23:14:24 +0000
Subject: [PATCH] b43: beacon templates where the AC microcode takes them

The AC cores' stock driver writes the two beacon templates at template
RAM 0x200 and 0x480, and the probe response at 0x700, on the 6.30 x86
build as on the 7.14 routers; b43 wrote them at 0x68 and 0x468, where the
AC microcode does not look. The lengths stay at BTL0/BTL1.

Template RAM advances its address on each data write, and the stock
driver writes a template with one RAM_CONTROL and then the words (80
words for each beacon on the agcombo, 76 for the probe response). On the
AC cores the template is now written the same way, with MACCONTROL read
once for the byte order instead of before each word. The other cores
keep b43_ram_write().

Not in this patch: the probe response template, which b43 does not
upload at all; the probe requests go to mac80211.
---
 drivers/net/wireless/broadcom/b43/b43.h  |  9 ++++
 drivers/net/wireless/broadcom/b43/main.c | 52 +++++++++++++++++++++---
 2 files changed, 56 insertions(+), 5 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/b43.h b/drivers/net/wireless/broadcom/b43/b43.h
index 959e01f..fec0dd3 100644
--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -298,6 +298,15 @@ enum {
 #define B43_SHM_SH_BTL0			0x0018	/* Beacon template length 0 */
 #define B43_SHM_SH_BT_BASE1		0x0468	/* Beacon template base 1 */
 #define B43_SHM_SH_BTL1			0x001A	/* Beacon template length 1 */
+/*
+ * The AC cores' microcode takes the two beacon templates here.
+ *
+ * TODO: probe-response offload. The probe response template goes at 0x0700,
+ * and the stock driver rewrites it after every beacon; b43 uploads none and
+ * leaves the probe requests to mac80211. See docs/retrace-todo.md.
+ */
+#define B43_SHM_SH_BT_BASE0_AC		0x0200
+#define B43_SHM_SH_BT_BASE1_AC		0x0480
 #define B43_SHM_SH_BTSFOFF		0x001C	/* Beacon TSF offset */
 #define B43_SHM_SH_TIMBPOS		0x001E	/* TIM B position in beacon */
 #define B43_SHM_SH_DTIMP		0x0012	/* DTIP period */
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 070abee..0dbf54d 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -500,6 +500,38 @@ static void b43_ram_write(struct b43_wldev *dev, u16 offset, u32 val)
 	b43_write32(dev, B43_MMIO_RAM_DATA, val);
 }
 
+/*
+ * Template RAM advances its address on every data write, and the AC cores'
+ * stock driver writes each template that way: RAM_CONTROL once, then the
+ * words. A sequence starts with next = U16_MAX and rewrites the control
+ * only where the offsets stop being consecutive.
+ */
+struct b43_ram_seq {
+	u16 next;
+	bool swap;
+};
+
+static void b43_ram_seq_write(struct b43_wldev *dev, struct b43_ram_seq *seq,
+			      u16 offset, u32 val)
+{
+	B43_WARN_ON(offset % 4 != 0);
+
+	if (offset != seq->next)
+		b43_write32(dev, B43_MMIO_RAM_CONTROL, offset);
+	b43_write32(dev, B43_MMIO_RAM_DATA, seq->swap ? swab32(val) : val);
+	seq->next = offset + sizeof(u32);
+}
+
+/* A template word: in sequence on the AC cores, one by one on the others. */
+static void b43_tpl_write(struct b43_wldev *dev, struct b43_ram_seq *seq,
+			  u16 offset, u32 val)
+{
+	if (seq)
+		b43_ram_seq_write(dev, seq, offset, val);
+	else
+		b43_ram_write(dev, offset, val);
+}
+
 static inline void b43_shm_control_word(struct b43_wldev *dev,
 					u16 routing, u16 offset)
 {
@@ -1677,17 +1709,23 @@ static void b43_write_template_common(struct b43_wldev *dev,
 {
 	u32 i, tmp;
 	struct b43_plcp_hdr4 plcp;
+	struct b43_ram_seq seq = { .next = U16_MAX }, *s = NULL;
+
+	if (dev->phy.type == B43_PHYTYPE_AC) {
+		seq.swap = b43_read32(dev, B43_MMIO_MACCTL) & B43_MACCTL_BE;
+		s = &seq;
+	}
 
 	plcp.data = 0;
 	b43_generate_plcp_hdr(&plcp, size + FCS_LEN, rate);
-	b43_ram_write(dev, ram_offset, le32_to_cpu(plcp.data));
+	b43_tpl_write(dev, s, ram_offset, le32_to_cpu(plcp.data));
 	ram_offset += sizeof(u32);
 	/* The PLCP is 6 bytes long, but we only wrote 4 bytes, yet.
 	 * So leave the first two bytes of the next write blank.
 	 */
 	tmp = (u32) (data[0]) << 16;
 	tmp |= (u32) (data[1]) << 24;
-	b43_ram_write(dev, ram_offset, tmp);
+	b43_tpl_write(dev, s, ram_offset, tmp);
 	ram_offset += sizeof(u32);
 	for (i = 2; i < size; i += sizeof(u32)) {
 		tmp = (u32) (data[i + 0]);
@@ -1697,7 +1735,7 @@ static void b43_write_template_common(struct b43_wldev *dev,
 			tmp |= (u32) (data[i + 2]) << 16;
 		if (i + 3 < size)
 			tmp |= (u32) (data[i + 3]) << 24;
-		b43_ram_write(dev, ram_offset + i - 2, tmp);
+		b43_tpl_write(dev, s, ram_offset + i - 2, tmp);
 	}
 	b43_shm_write16(dev, B43_SHM_SHARED, shm_size_offset,
 			size + sizeof(struct b43_plcp_hdr6));
@@ -1858,7 +1896,9 @@ static void b43_upload_beacon0(struct b43_wldev *dev)
 
 	if (wl->beacon0_uploaded)
 		return;
-	b43_write_beacon_template(dev, B43_SHM_SH_BT_BASE0, B43_SHM_SH_BTL0);
+	b43_write_beacon_template(dev, dev->phy.type == B43_PHYTYPE_AC ?
+				  B43_SHM_SH_BT_BASE0_AC : B43_SHM_SH_BT_BASE0,
+				  B43_SHM_SH_BTL0);
 	wl->beacon0_uploaded = true;
 }
 
@@ -1868,7 +1908,9 @@ static void b43_upload_beacon1(struct b43_wldev *dev)
 
 	if (wl->beacon1_uploaded)
 		return;
-	b43_write_beacon_template(dev, B43_SHM_SH_BT_BASE1, B43_SHM_SH_BTL1);
+	b43_write_beacon_template(dev, dev->phy.type == B43_PHYTYPE_AC ?
+				  B43_SHM_SH_BT_BASE1_AC : B43_SHM_SH_BT_BASE1,
+				  B43_SHM_SH_BTL1);
 	wl->beacon1_uploaded = true;
 }
 
-- 
