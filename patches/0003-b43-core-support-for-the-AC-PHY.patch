+++ b/drivers/net/wireless/broadcom/b43/leds.c
@@ -77,16 +77,15 @@ static void b43_leds_work(struct work_struct *work)
 	struct b43_leds *leds = container_of(work, struct b43_leds, work);
 	struct b43_wl *wl = container_of(leds, struct b43_wl, leds);
 	struct b43_wldev *dev;
+	unsigned int i;
 
 	mutex_lock(&wl->mutex);
 	dev = wl->current_dev;
 	if (unlikely(!dev || b43_status(dev) < B43_STAT_STARTED))
 		goto out_unlock;
 
-	b43_led_update(dev, &wl->leds.led_tx);
-	b43_led_update(dev, &wl->leds.led_rx);
-	b43_led_update(dev, &wl->leds.led_radio);
-	b43_led_update(dev, &wl->leds.led_assoc);
+	for (i = 0; i < ARRAY_SIZE(wl->leds.led); i++)
+		b43_led_update(dev, &wl->leds.led[i]);
 
 out_unlock:
 	mutex_unlock(&wl->mutex);
@@ -105,19 +104,27 @@ static void b43_led_brightness_set(struct led_classdev *led_dev,
 	}
 }
 
-static int b43_register_led(struct b43_wldev *dev, struct b43_led *led,
+static int b43_register_led(struct b43_wldev *dev,
 			    const char *name, const char *default_trigger,
-			    u8 led_index, bool activelow)
+			    u8 led_index, bool activelow, bool radio)
