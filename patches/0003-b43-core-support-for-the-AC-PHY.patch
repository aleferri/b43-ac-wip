+	dev->phy.bw_clkbits = bits;
+	tmp = bcma_aread32(dev->dev->bdev, BCMA_IOCTL);
+	tmp &= ~B43_BCMA_IOCTL_PHY_BW;
+	tmp |= bits;
+	bcma_awrite32(dev->dev->bdev, BCMA_IOCTL, tmp);
+	bcma_aread32(dev->dev->bdev, BCMA_IOCTL);
+#endif
+}
