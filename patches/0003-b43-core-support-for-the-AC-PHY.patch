 drivers/net/wireless/broadcom/b43/leds.c      | 172 +++---
 drivers/net/wireless/broadcom/b43/leds.h      |  19 +-
 drivers/net/wireless/broadcom/b43/main.c      | 528 ++++++++++++++++--
 .../net/wireless/broadcom/b43/phy_common.c    |  21 +
