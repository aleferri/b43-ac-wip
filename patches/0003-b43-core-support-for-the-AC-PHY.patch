diff --git a/drivers/net/wireless/broadcom/b43/Kconfig b/drivers/net/wireless/broadcom/b43/Kconfig
index 4559549..616aa17 100644
--- a/drivers/net/wireless/broadcom/b43/Kconfig
+++ b/drivers/net/wireless/broadcom/b43/Kconfig
@@ -157,6 +157,18 @@ config B43_PHY_AC
 
 	  Say N, this is BROKEN and crashes driver.
 
+config B43_DFS
+	bool "Radar channels in AP mode on the AC-PHY"
+	depends on B43_PHY_AC && CFG80211_CERTIFICATION_ONUS
+	help
+	  Let an access point run on channels that require radar detection.
+	  mac80211 runs the channel availability check and the AC-PHY polls
+	  its radar pulse FIFOs. Any pulse over the detection threshold is
+	  reported as a radar: the pulses are not matched against the radar
+	  patterns, which certification requires.
+
+	  Say N.
+
 # This config option automatically enables b43 LEDS support,
 # if it's possible.
 config B43_LEDS
diff --git a/drivers/net/wireless/broadcom/b43/b43.h b/drivers/net/wireless/broadcom/b43/b43.h
index 67b4bac..7e9ff68 100644
--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -310,6 +310,8 @@ enum {
 #define B43_SHM_SH_PRTLEN		0x004A	/* Probe Response template length */
 #define B43_SHM_SH_PRMAXTIME		0x0074	/* Probe Response max time */
 #define B43_SHM_SH_PRPHYCTL		0x0188	/* Probe Response PHY TX control word */
+/* SHM_SHARED station address, AC PHY: three words, low byte first */
+#define B43_SHM_SH_AC_MACADDR		0x078C
 /* SHM_SHARED rate tables */
 #define B43_SHM_SH_OFDMDIRECT		0x01C0	/* Pointer to OFDM direct map */
 #define B43_SHM_SH_OFDMBASIC		0x01E0	/* Pointer to OFDM basic rate map */
@@ -399,6 +401,17 @@ enum {
 #define B43_MACFILTER_SELF		0x0000
 #define B43_MACFILTER_BSSID		0x0003
 
+/* Address match table, wide layout (802.11 core revision >= 42). Same routing
+ * as the older receive-match table, B43_SHM_RCMTA, two words per row. The top
+ * two rows replace the MACFILTER port, and the flags half-word above the
+ * address says the row is live and what it matches. */
+#define B43_AMT_WIDE_ENTRIES		64
+#define B43_AMT_BSSID			0x3e
+#define B43_AMT_SELF			0x3f
+#define B43_AMT_F_VALID			0x8000
+#define B43_AMT_F_BSSID			(B43_AMT_F_VALID | 0x0002)
+#define B43_AMT_F_SELF			(B43_AMT_F_VALID | 0x0008)
+
 /* PowerControl */
 #define B43_PCTL_IN			0xB0
 #define B43_PCTL_OUT			0xB4
@@ -871,6 +884,14 @@ struct b43_wldev {
 	/* Periodic tasks */
 	struct delayed_work periodic_work;
 	unsigned int periodic_state;
+	struct delayed_work radar_work;
+
+	/*
+	 * AC PHY: a channel availability check holds transmission back, and
+	 * the configuration the radio was last tuned to by b43_op_config().
+	 */
+	bool cac_pending;
+	struct cfg80211_chan_def tuned_chandef;
 
 	struct work_struct restart_work;
 
diff --git a/drivers/net/wireless/broadcom/b43/dma.c b/drivers/net/wireless/broadcom/b43/dma.c
index 760d1a2..4fd0e0b 100644
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -404,19 +404,27 @@ static inline
 	}
 }
 
+/*
+ * Descriptor-ring memory size (and, via dma_alloc_coherent()'s power-of-two
+ * alignment, its alignment): 4K for 30/32-bit DMA, 8K for 64-bit DMA. The 8K
+ * alignment matters because of a hardware bug where bit 0x00001000 of the DMA
+ * address leaks into B43_DMA64_RXSTATUS. The BCM4352-family AC-PHY DMA64
+ * engine additionally requires the ring to be 64 KB-aligned and to never
+ * cross a 64 KB boundary (found empirically by raising the ring alignment
+ * until the engine came up); the ring itself is far smaller, so a 64 KB allocation
+ * both gives that alignment and keeps the ring inside one 64 KB block.
+ */
+static unsigned int b43_dma_ringmemsize(struct b43_dmaring *ring)
+{
+	if (ring->dev->phy.type == B43_PHYTYPE_AC)
+		return 64 * 1024;
+	return (ring->type == B43_DMA_64BIT) ?
+		B43_DMA64_RINGMEMSIZE : B43_DMA32_RINGMEMSIZE;
+}
+
 static int alloc_ringmemory(struct b43_dmaring *ring)
 {
-	/* The specs call for 4K buffers for 30- and 32-bit DMA with 4K
-	 * alignment and 8K buffers for 64-bit DMA with 8K alignment.
-	 * In practice we could use smaller buffers for the latter, but the
-	 * alignment is really important because of the hardware bug. If bit
-	 * 0x00001000 is used in DMA address, some hardware (like BCM4331)
-	 * copies that bit into B43_DMA64_RXSTATUS and we get false values from
-	 * B43_DMA64_RXSTATDPTR. Let's just use 8K buffers even if we don't use
-	 * more than 256 slots for ring.
-	 */
-	u16 ring_mem_size = (ring->type == B43_DMA_64BIT) ?
-				B43_DMA64_RINGMEMSIZE : B43_DMA32_RINGMEMSIZE;
+	unsigned int ring_mem_size = b43_dma_ringmemsize(ring);
 
 	ring->descbase = dma_alloc_coherent(ring->dev->dev->dma_dev,
 					    ring_mem_size, &(ring->dmabase),
@@ -429,8 +437,8 @@ static int alloc_ringmemory(struct b43_dmaring *ring)
 
 static void free_ringmemory(struct b43_dmaring *ring)
 {
-	u16 ring_mem_size = (ring->type == B43_DMA_64BIT) ?
-				B43_DMA64_RINGMEMSIZE : B43_DMA32_RINGMEMSIZE;
+	unsigned int ring_mem_size = b43_dma_ringmemsize(ring);
+
 	dma_free_coherent(ring->dev->dev->dma_dev, ring_mem_size,
 			  ring->descbase, ring->dmabase);
 }
diff --git a/drivers/net/wireless/broadcom/b43/leds.c b/drivers/net/wireless/broadcom/b43/leds.c
