From 7bf1ba5cff53becd15493bc2a9c138c1528cb660 Mon Sep 17 00:00:00 2001
From: Alessandro Ferri <aleferri@example.invalid>
Date: Fri, 11 Sep 2026 09:23:27 +0000
Subject: [PATCH 17/17] b43: drive the LEDs the board maps on GPIO pins above 3

b43 knows four LEDs, one per SPROM ledbh0-3 field, and one classdev slot
per role. Broadcom boards map LEDs on any of the sixteen GPIO lines,
through NVRAM ledbh4..ledbh15, which struct ssb_sprom now carries as
gpio_ext[]; on the Netgear D6220 and D-Link DSL-3580L the 5 GHz activity
LED is ledbh10=0x88, gpio 10 active-low, next to the ledbh0-2 defaults on
gpio 0-2. The stock driver builds its LED mask from both -- 0x407 on those
boards -- and drives them from wlc_bmac_hw_up(), wlc_bmac_led() and
wlc_bmac_led_hw_deinit() on the chipcommon GPIO registers; b43 never saw
the pin.

Read gpio_ext[] in leds.c. Pins 0-3 keep their behaviour, defaults
included; a pin above 3 counts only when its ledbh is set, since an unset
field stays at 0 and 0xff is the no-LED value, and an unmapped pin is left
untouched -- gpio 9 may be the ucode's PA control.

One classdev per role could not hold two activity LEDs, so the slots
become a per-pin pool of 2 * B43_MAX_NR_LEDS entries -- an activity LED
takes the TX and the RX trigger on the same pin -- with a flag for the
radio role, which is the one whose initial state follows the radio. The
LED names are unchanged; the LED core disambiguates duplicates itself.

b43_gpio_init() routes the pins of the registered LEDs to the MAC, in both
GPIOCTL and the MAC's GPIO_MASK, next to the fixed 0-3 it always took. The
LEDs are driven the way b43 drives them, through the MAC's GPIO_CONTROL,
not the way the stock driver does; the AC-PHY port does not reproduce the
vendor's chipcommon writes, which the trace comparison keeps in its
perimeter as the core's.

Signed-off-by: Alessandro Ferri <aleferri@example.invalid>
---
 drivers/net/wireless/broadcom/b43/leds.c | 172 +++++++++++++----------
 drivers/net/wireless/broadcom/b43/leds.h |  19 ++-
 drivers/net/wireless/broadcom/b43/main.c |   7 +-
 3 files changed, 111 insertions(+), 87 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/leds.c b/drivers/net/wireless/broadcom/b43/leds.c
index bfe1be3..8a3bc7e 100644
--- a/drivers/net/wireless/broadcom/b43/leds.c
+++ b/drivers/net/wireless/broadcom/b43/leds.c
@@ -77,16 +77,15 @@ static void b43_leds_work(struct work_struct *work)
 	struct b43_leds *leds = container_of(work, struct b43_leds, work);
 	struct b43_wl *wl = container_of(leds, struct b43_wl, leds);
 	struct b43_wldev *dev;
+	unsigned int i;
 
 	mutex_lock(&wl->mutex);
 	dev = wl->current_dev;
 	if (unlikely(!dev || b43_status(dev) < B43_STAT_STARTED))
 		goto out_unlock;
 
-	b43_led_update(dev, &wl->leds.led_tx);
-	b43_led_update(dev, &wl->leds.led_rx);
-	b43_led_update(dev, &wl->leds.led_radio);
-	b43_led_update(dev, &wl->leds.led_assoc);
+	for (i = 0; i < ARRAY_SIZE(wl->leds.led); i++)
+		b43_led_update(dev, &wl->leds.led[i]);
 
 out_unlock:
 	mutex_unlock(&wl->mutex);
@@ -105,19 +104,27 @@ static void b43_led_brightness_set(struct led_classdev *led_dev,
 	}
 }
 
-static int b43_register_led(struct b43_wldev *dev, struct b43_led *led,
+static int b43_register_led(struct b43_wldev *dev,
 			    const char *name, const char *default_trigger,
-			    u8 led_index, bool activelow)
+			    u8 led_index, bool activelow, bool radio)
 {
+	struct b43_leds *leds = &dev->wl->leds;
+	struct b43_led *led;
+	unsigned int i;
 	int err;
 
-	if (led->wl)
-		return -EEXIST;
 	if (!default_trigger)
 		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(leds->led); i++)
+		if (!leds->led[i].wl)
+			break;
+	if (i == ARRAY_SIZE(leds->led))
+		return -ENOSPC;
+	led = &leds->led[i];
 	led->wl = dev->wl;
 	led->index = led_index;
 	led->activelow = activelow;
+	led->radio = radio;
 	strscpy(led->name, name, sizeof(led->name));
 	atomic_set(&led->state, 0);
 
@@ -163,14 +170,12 @@ static void b43_map_led(struct b43_wldev *dev,
 	case B43_LED_APTRANSFER:
 		snprintf(name, sizeof(name),
 			 "b43-%s::tx", wiphy_name(hw->wiphy));
-		b43_register_led(dev, &dev->wl->leds.led_tx, name,
-				 ieee80211_get_tx_led_name(hw),
-				 led_index, activelow);
+		b43_register_led(dev, name, ieee80211_get_tx_led_name(hw),
+				 led_index, activelow, false);
 		snprintf(name, sizeof(name),
 			 "b43-%s::rx", wiphy_name(hw->wiphy));
-		b43_register_led(dev, &dev->wl->leds.led_rx, name,
-				 ieee80211_get_rx_led_name(hw),
-				 led_index, activelow);
+		b43_register_led(dev, name, ieee80211_get_rx_led_name(hw),
+				 led_index, activelow, false);
 		break;
 	case B43_LED_RADIO_ALL:
 	case B43_LED_RADIO_A:
@@ -178,17 +183,15 @@ static void b43_map_led(struct b43_wldev *dev,
 	case B43_LED_MODE_BG:
 		snprintf(name, sizeof(name),
 			 "b43-%s::radio", wiphy_name(hw->wiphy));
-		b43_register_led(dev, &dev->wl->leds.led_radio, name,
-				 ieee80211_get_radio_led_name(hw),
-				 led_index, activelow);
+		b43_register_led(dev, name, ieee80211_get_radio_led_name(hw),
+				 led_index, activelow, true);
 		break;
 	case B43_LED_WEIRD:
 	case B43_LED_ASSOC:
 		snprintf(name, sizeof(name),
 			 "b43-%s::assoc", wiphy_name(hw->wiphy));
-		b43_register_led(dev, &dev->wl->leds.led_assoc, name,
-				 ieee80211_get_assoc_led_name(hw),
-				 led_index, activelow);
+		b43_register_led(dev, name, ieee80211_get_assoc_led_name(hw),
+				 led_index, activelow, false);
 		break;
 	default:
 		b43warn(dev->wl, "LEDs: Unknown behaviour 0x%02X\n",
@@ -197,19 +200,42 @@ static void b43_map_led(struct b43_wldev *dev,
 	}
 }
 
-static void b43_led_get_sprominfo(struct b43_wldev *dev,
+/* Returns false when nothing sits on the pin and it must be left alone. */
+static bool b43_led_get_sprominfo(struct b43_wldev *dev,
 				  unsigned int led_index,
 				  enum b43_led_behaviour *behaviour,
 				  bool *activelow)
 {
-	u8 sprom[4];
-
-	sprom[0] = dev->dev->bus_sprom->gpio0;
-	sprom[1] = dev->dev->bus_sprom->gpio1;
-	sprom[2] = dev->dev->bus_sprom->gpio2;
-	sprom[3] = dev->dev->bus_sprom->gpio3;
+	const struct ssb_sprom *bus_sprom = dev->dev->bus_sprom;
+	u8 sprom[B43_MAX_NR_LEDS];
+
+	sprom[0] = bus_sprom->gpio0;
+	sprom[1] = bus_sprom->gpio1;
+	sprom[2] = bus_sprom->gpio2;
+	sprom[3] = bus_sprom->gpio3;
+	BUILD_BUG_ON(sizeof(sprom) != 4 + sizeof(bus_sprom->gpio_ext));
+	memcpy(&sprom[4], bus_sprom->gpio_ext, sizeof(bus_sprom->gpio_ext));
+
+	/* Pins 4 and up come from NVRAM only and have no default; the
+	 * fallback SPROM leaves an unset ledbh at 0, so 0 and 0xff both
+	 * mean there is no LED here. Pins 0-3 keep their behaviour:
+	 * unmapped ones are still driven off. */
+	if (led_index >= 4 &&
+	    (sprom[led_index] == 0 || sprom[led_index] == 0xff)) {
+		*behaviour = B43_LED_OFF;
+		*activelow = false;
+		return false;
+	}
 
-	if ((sprom[0] & sprom[1] & sprom[2] & sprom[3]) == 0xff) {
+	if (led_index >= 4 ||
+	    (sprom[0] & sprom[1] & sprom[2] & sprom[3]) != 0xff) {
+		/* keep LED disabled if no mapping is defined */
+		if (sprom[led_index] == 0xff)
+			*behaviour = B43_LED_OFF;
+		else
+			*behaviour = sprom[led_index] & B43_LED_BEHAVIOUR;
+		*activelow = !!(sprom[led_index] & B43_LED_ACTIVELOW);
+	} else {
 		/* There is no LED information in the SPROM
 		 * for this LED. Hardcode it here. */
 		*activelow = false;
@@ -234,16 +260,22 @@ static void b43_led_get_sprominfo(struct b43_wldev *dev,
 		default:
 			*behaviour = B43_LED_OFF;
 			B43_WARN_ON(1);
-			return;
+			return false;
 		}
-	} else {
-		/* keep LED disabled if no mapping is defined */
-		if (sprom[led_index] == 0xff)
-			*behaviour = B43_LED_OFF;
-		else
-			*behaviour = sprom[led_index] & B43_LED_BEHAVIOUR;
-		*activelow = !!(sprom[led_index] & B43_LED_ACTIVELOW);
 	}
+	return true;
+}
+
+/* The GPIO pins the registered LEDs sit on, for the MAC to take over. */
+u32 b43_leds_gpio_mask(struct b43_wl *wl)
+{
+	u32 mask = 0;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(wl->leds.led); i++)
+		if (wl->leds.led[i].wl)
+			mask |= BIT(wl->leds.led[i].index);
+	return mask;
 }
 
 void b43_leds_init(struct b43_wldev *dev)
@@ -251,45 +283,28 @@ void b43_leds_init(struct b43_wldev *dev)
 	struct b43_led *led;
 	unsigned int i;
 	enum b43_led_behaviour behaviour;
-	bool activelow;
-
-	/* Sync the RF-kill LED state (if we have one) with radio and switch states. */
-	led = &dev->wl->leds.led_radio;
-	if (led->wl) {
-		if (dev->phy.radio_on && b43_is_hw_radio_enabled(dev)) {
+	bool activelow, on;
+
+	/* The radio LEDs follow the radio and switch state, the others
+	 * start off. */
+	for (i = 0; i < ARRAY_SIZE(dev->wl->leds.led); i++) {
+		led = &dev->wl->leds.led[i];
+		if (!led->wl)
+			continue;
+		on = led->radio && dev->phy.radio_on &&
+		     b43_is_hw_radio_enabled(dev);
+		if (on)
 			b43_led_turn_on(dev, led->index, led->activelow);
-			led->hw_state = true;
-			atomic_set(&led->state, 1);
-		} else {
+		else
 			b43_led_turn_off(dev, led->index, led->activelow);
-			led->hw_state = false;
-			atomic_set(&led->state, 0);
-		}
-	}
-
-	/* Initialize TX/RX/ASSOC leds */
-	led = &dev->wl->leds.led_tx;
-	if (led->wl) {
-		b43_led_turn_off(dev, led->index, led->activelow);
-		led->hw_state = false;
-		atomic_set(&led->state, 0);
-	}
-	led = &dev->wl->leds.led_rx;
-	if (led->wl) {
-		b43_led_turn_off(dev, led->index, led->activelow);
-		led->hw_state = false;
-		atomic_set(&led->state, 0);
-	}
-	led = &dev->wl->leds.led_assoc;
-	if (led->wl) {
-		b43_led_turn_off(dev, led->index, led->activelow);
-		led->hw_state = false;
-		atomic_set(&led->state, 0);
+		led->hw_state = on;
+		atomic_set(&led->state, on);
 	}
 
 	/* Initialize other LED states. */
 	for (i = 0; i < B43_MAX_NR_LEDS; i++) {
-		b43_led_get_sprominfo(dev, i, &behaviour, &activelow);
+		if (!b43_led_get_sprominfo(dev, i, &behaviour, &activelow))
+			continue;
 		switch (behaviour) {
 		case B43_LED_OFF:
 			b43_led_turn_off(dev, i, activelow);
@@ -309,11 +324,12 @@ void b43_leds_init(struct b43_wldev *dev)
 void b43_leds_exit(struct b43_wldev *dev)
 {
 	struct b43_leds *leds = &dev->wl->leds;
+	unsigned int i;
 
-	b43_led_turn_off(dev, leds->led_tx.index, leds->led_tx.activelow);
-	b43_led_turn_off(dev, leds->led_rx.index, leds->led_rx.activelow);
-	b43_led_turn_off(dev, leds->led_assoc.index, leds->led_assoc.activelow);
-	b43_led_turn_off(dev, leds->led_radio.index, leds->led_radio.activelow);
+	for (i = 0; i < ARRAY_SIZE(leds->led); i++)
+		if (leds->led[i].wl)
+			b43_led_turn_off(dev, leds->led[i].index,
+					 leds->led[i].activelow);
 }
 
 void b43_leds_stop(struct b43_wldev *dev)
@@ -334,7 +350,8 @@ void b43_leds_register(struct b43_wldev *dev)
 
 	/* Register the LEDs to the LED subsystem. */
 	for (i = 0; i < B43_MAX_NR_LEDS; i++) {
-		b43_led_get_sprominfo(dev, i, &behaviour, &activelow);
+		if (!b43_led_get_sprominfo(dev, i, &behaviour, &activelow))
+			continue;
 		b43_map_led(dev, i, behaviour, activelow);
 	}
 }
@@ -342,9 +359,8 @@ void b43_leds_register(struct b43_wldev *dev)
 void b43_leds_unregister(struct b43_wl *wl)
 {
 	struct b43_leds *leds = &wl->leds;
+	unsigned int i;
 
-	b43_unregister_led(&leds->led_tx);
-	b43_unregister_led(&leds->led_rx);
-	b43_unregister_led(&leds->led_assoc);
-	b43_unregister_led(&leds->led_radio);
+	for (i = 0; i < ARRAY_SIZE(leds->led); i++)
+		b43_unregister_led(&leds->led[i]);
 }
diff --git a/drivers/net/wireless/broadcom/b43/leds.h b/drivers/net/wireless/broadcom/b43/leds.h
index 5ebd1b2..eb68796 100644
--- a/drivers/net/wireless/broadcom/b43/leds.h
+++ b/drivers/net/wireless/broadcom/b43/leds.h
@@ -23,6 +23,8 @@ struct b43_led {
 	/* If activelow is true, the LED is ON if the
 	 * bit is switched off. */
 	bool activelow;
+	/* Follows the radio state instead of a mac80211 trigger. */
+	bool radio;
 	/* The unique name string for this LED device. */
 	char name[B43_LED_MAX_NAME_LEN + 1];
 	/* The current status of the LED. This is updated locklessly. */
@@ -31,18 +33,18 @@ struct b43_led {
 	bool hw_state;
 };
 
+/* One per GPIO pin the MAC's 16-bit GPIO_CONTROL register can drive. */
+#define B43_MAX_NR_LEDS			16
+
 struct b43_leds {
-	struct b43_led led_tx;
-	struct b43_led led_rx;
-	struct b43_led led_radio;
-	struct b43_led led_assoc;
+	/* Two per pin at most: an activity LED takes the TX and the RX
+	 * trigger on the same pin. */
+	struct b43_led led[2 * B43_MAX_NR_LEDS];
 
 	bool stop;
 	struct work_struct work;
 };
 
-#define B43_MAX_NR_LEDS			4
-
 #define B43_LED_BEHAVIOUR		0x7F
 #define B43_LED_ACTIVELOW		0x80
 /* LED behaviour values */
@@ -66,6 +68,7 @@ void b43_leds_unregister(struct b43_wl *wl);
 void b43_leds_init(struct b43_wldev *dev);
 void b43_leds_exit(struct b43_wldev *dev);
 void b43_leds_stop(struct b43_wldev *dev);
+u32 b43_leds_gpio_mask(struct b43_wl *wl);
 
 
 #else /* CONFIG_B43_LEDS */
@@ -90,6 +93,10 @@ static inline void b43_leds_exit(struct b43_wldev *dev)
 static inline void b43_leds_stop(struct b43_wldev *dev)
 {
 }
+static inline u32 b43_leds_gpio_mask(struct b43_wl *wl)
+{
+	return 0;
+}
 #endif /* CONFIG_B43_LEDS */
 
 #endif /* B43_LEDS_H_ */
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 2420d39..556e4a7 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -2998,13 +2998,14 @@ static int b43_gpio_init(struct b43_wldev *dev)
 #ifdef CONFIG_B43_SSB
 	struct ssb_device *gpiodev;
 #endif
+	u32 leds = b43_leds_gpio_mask(dev->wl);
 	u32 mask, set;
 
 	b43_maskset32(dev, B43_MMIO_MACCTL, ~B43_MACCTL_GPOUTSMSK, 0);
-	b43_maskset16(dev, B43_MMIO_GPIO_MASK, ~0, 0xF);
+	b43_maskset16(dev, B43_MMIO_GPIO_MASK, ~0, 0xF | leds);
 
-	mask = 0x0000001F;
-	set = 0x0000000F;
+	mask = 0x0000001F | leds;
+	set = 0x0000000F | leds;
 	if (dev->dev->chip_id == 0x4301) {
 		mask |= 0x0060;
 		set |= 0x0060;
-- 
