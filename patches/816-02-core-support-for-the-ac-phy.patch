+static int b43_bsinit(struct b43_wldev *dev)
+{
+	int err = b43_upload_initvals_band(dev);
+
+	if (!err && dev->phy.type == B43_PHYTYPE_AC)
+		b43_bsinit_ac(dev);
+	return err;
+}
