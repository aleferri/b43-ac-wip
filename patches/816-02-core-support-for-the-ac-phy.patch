diff --git a/drivers/net/wireless/broadcom/b43/Kconfig b/drivers/net/wireless/broadcom/b43/Kconfig
index 5f008b4..fc53f0f 100644
--- a/drivers/net/wireless/broadcom/b43/Kconfig
+++ b/drivers/net/wireless/broadcom/b43/Kconfig
@@ -1,12 +1,11 @@
 # SPDX-License-Identifier: GPL-2.0-only
 config B43
 	tristate "Broadcom 43xx wireless support (mac80211 stack)"
-	depends on m
 	depends on (BCMA_POSSIBLE || SSB_POSSIBLE) && MAC80211 && HAS_DMA
 	select BCMA if B43_BCMA
 	select SSB if B43_SSB
-	depends on FW_LOADER
-	depends on CORDIC
+	select FW_LOADER
+	select CORDIC
 	help
 	  b43 is a driver for the Broadcom 43xx series wireless devices.
 
@@ -63,21 +62,21 @@ endchoice
 config B43_PCI_AUTOSELECT
 	bool
 	depends on B43 && SSB_PCIHOST_POSSIBLE
-	depends on SSB_PCIHOST
-	depends on SSB_B43_PCI_BRIDGE
+	select SSB_PCIHOST
+	select SSB_B43_PCI_BRIDGE
 	default y
 
 # Auto-select SSB PCICORE driver, if possible
 config B43_PCICORE_AUTOSELECT
 	bool
 	depends on B43 && SSB_DRIVER_PCICORE_POSSIBLE
-	depends on SSB_DRIVER_PCICORE
+	select SSB_DRIVER_PCICORE
 	default y
 
 config B43_SDIO
 	bool "Broadcom 43xx SDIO device support"
 	depends on B43 && B43_SSB && SSB_SDIOHOST_POSSIBLE
-	depends on SSB_SDIOHOST
+	select SSB_SDIOHOST
 	help
 	  Broadcom 43xx device support for Soft-MAC SDIO devices.
 
@@ -96,13 +95,13 @@ config B43_SDIO
 config B43_BCMA_PIO
 	bool
 	depends on B43 && B43_BCMA
-	depends on BCMA_BLOCKIO
+	select BCMA_BLOCKIO
 	default y
 
 config B43_PIO
 	bool "Broadcom 43xx PIO support"
 	depends on B43 && B43_SSB
-	depends on SSB_BLOCKIO
+	select SSB_BLOCKIO
 	default y
 
 config B43_PHY_G
@@ -158,6 +157,18 @@ config B43_PHY_AC
 
 	  Say N, this is BROKEN and crashes driver.
 
+config B43_DFS
+	bool "Radar channels in AP mode on the AC-PHY"
+	depends on B43_PHY_AC && CFG80211_CERTIFICATION_ONUS
+	help
+	  Let an access point run on channels that require radar detection.
+	  mac80211 runs the channel availability check and the AC-PHY polls
+	  its radar pulse FIFOs. Any pulse over the detection threshold is
+	  reported as a radar: the pulses are not matched against the radar
+	  patterns, which certification requires.
+
+	  Say N.
+
 # This config option automatically enables b43 LEDS support,
 # if it's possible.
 config B43_LEDS
