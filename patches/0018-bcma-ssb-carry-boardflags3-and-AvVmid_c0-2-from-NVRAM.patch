From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alessandro Ferri <aleferri@example.invalid>
Date: Fri, 25 Sep 2026 18:00:00 +0000
Subject: [PATCH 18/18] bcma: ssb: carry boardflags3 and AvVmid_c0..2 from NVRAM

The AC-PHY programs each chain's power-detector input with a pair, Av and
Vmid, per band. A board gives the pairs in NVRAM as AvVmid_c0..2 -- ten
comma-separated values, Av,Vmid for 2g, 5gl, 5gml, 5gmu and 5gh, as in the
public Broadcom NVRAM files -- and the stock driver takes them from there
only when boardflags3 has BFL3_AvVim (0x40000000), "load AvVim from nvram"
in the same files; without the flag it uses a default set of its own.

AvVmid has no field in struct ssb_sprom; add avvmid[3][5][2] and
avvmid_valid, the chains whose variable parsed, so that a flag without the
variable leaves the driver on its defaults. boardflags3 has one, filled
from NVRAM by bcm47xx_sprom_fill_auto() for a SPROM that comes from NVRAM,
but nothing fills it for a SPROM read from the device: the rev 11
extraction does not take the word. Read both in
bcm47xx_sprom_fill_nvram_only(), next to ledbh4..15, which runs in either
case.

Signed-off-by: Alessandro Ferri <aleferri@example.invalid>
---
 drivers/firmware/broadcom/bcm47xx_sprom.c | 33 +++++++++++++++++++++++
 include/linux/ssb/ssb.h                   |  3 +++
 2 files changed, 36 insertions(+)

diff --git a/drivers/firmware/broadcom/bcm47xx_sprom.c b/drivers/firmware/broadcom/bcm47xx_sprom.c
--- a/drivers/firmware/broadcom/bcm47xx_sprom.c
+++ b/drivers/firmware/broadcom/bcm47xx_sprom.c
@@ -172,6 +172,33 @@ static void nvram_read_alpha2(const char *prefix, const char *name,
 	memcpy(val, buf, 2);
 }
 
+/*
+ * AvVmid_c<core>: Av,Vmid of the chain's power-detector input for 2g, 5gl,
+ * 5gml, 5gmu and 5gh. Taken whole or not at all: a list that does not parse
+ * into ten values leaves the chain on the driver's defaults.
+ */
+static void nvram_read_avvmid(const char *prefix, int core,
+			      struct ssb_sprom *sprom, bool fallback)
+{
+	char name[sizeof("AvVmid_c0")];
+	char buf[64], *p = buf, *tok;
+	u8 v[10];
+	int n = 0;
+
+	snprintf(name, sizeof(name), "AvVmid_c%d", core);
+	if (get_nvram_var(prefix, NULL, name, buf, sizeof(buf), fallback) < 0)
+		return;
+	while (n < ARRAY_SIZE(v) && (tok = strsep(&p, ",")) != NULL) {
+		if (kstrtou8(strim(tok), 0, &v[n]))
+			return;
+		n++;
+	}
+	if (n != ARRAY_SIZE(v))
+		return;
+	memcpy(sprom->avvmid[core], v, sizeof(v));
+	sprom->avvmid_valid |= BIT(core);
+}
+
 /*
  * The variables no SPROM revision has a word for: the board sets them in
  * NVRAM only, next to the device's other entries, and the stock driver
@@ -189,6 +216,12 @@ static void bcm47xx_sprom_fill_nvram_only(struct ssb_sprom *sprom,
 		nvram_read_u8(prefix, NULL, name, &sprom->gpio_ext[i], 0xff,
 			      fallback);
 	}
+
+	nvram_read_u32(prefix, NULL, "boardflags3", &sprom->boardflags3, 0,
+		       fallback);
+	sprom->avvmid_valid = 0;
+	for (i = 0; i < ARRAY_SIZE(sprom->avvmid); i++)
+		nvram_read_avvmid(prefix, i, sprom, fallback);
 }
 
 /* This is one-function-only macro, it uses local "sprom" variable! */
diff --git a/include/linux/ssb/ssb.h b/include/linux/ssb/ssb.h
--- a/include/linux/ssb/ssb.h
+++ b/include/linux/ssb/ssb.h
@@ -78,6 +78,9 @@ struct ssb_sprom {
 	u8 gpio3;		/* GPIO pin 3 */
 	u8 gpio_ext[12];	/* GPIO pins 4-15; NVRAM ledbh4-ledbh15 only,
 				 * no SPROM revision carries them */
+	u8 avvmid[3][5][2];	/* NVRAM AvVmid_c0..2: {Av, Vmid} for 2g, 5gl,
+				 * 5gml, 5gmu, 5gh */
+	u8 avvmid_valid;	/* bit per chain whose AvVmid_cN parsed */
 	u8 maxpwr_bg;		/* 2.4GHz Amplifier Max Power (in dBm Q5.2) */
 	u8 maxpwr_al;		/* 5.2GHz Amplifier Max Power (in dBm Q5.2) */
 	u8 maxpwr_a;		/* 5.3GHz Amplifier Max Power (in dBm Q5.2) */
-- 
