From ca9069c8b9023b0bffec8156b38f44f0412c6a89 Mon Sep 17 00:00:00 2001
From: Alessio Ferri <alessio.ferri.3012@gmail.com>
Date: Mon, 28 Sep 2026 22:58:57 +0000
Subject: [PATCH] b43: read back register addresses as the stock driver does

The object memory address is read back after every write on the AC
cores: the stock driver does it on the x86 hybrid build and on the MIPS
routers alike (5582 and 4508 reads in the two bus captures).

On BCM63xx routers with a PCIe radio the PHY and radio addresses are read
back too, after every write. That is what flush_writes already does on
the BCM4716; it is now also set there, and b43_write16f() is compiled for
both. With every address write flushed the PCI write counter, which reads
PHY_VER or MACCONTROL every 24 writes, has nothing left to bound, and the
stock driver on those hosts does not do it.
---
 drivers/net/wireless/broadcom/b43/b43.h       | 20 +++++++++++++++----
 drivers/net/wireless/broadcom/b43/bus.c       |  4 ++++
 drivers/net/wireless/broadcom/b43/main.c      |  6 ++++++
 .../net/wireless/broadcom/b43/phy_common.c    |  4 ++--
 .../net/wireless/broadcom/b43/phy_common.h    |  3 ++-
 5 files changed, 30 insertions(+), 7 deletions(-)

diff --git a/drivers/net/wireless/broadcom/b43/b43.h b/drivers/net/wireless/broadcom/b43/b43.h
index 1f4c364..959e01f 100644
--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -1059,14 +1059,26 @@ static inline void b43_write16(struct b43_wldev *dev, u16 offset, u16 value)
 	dev->dev->write16(dev->dev, offset, value);
 }
 
-/* To optimize this check for flush_writes on BCM47XX_BCMA only. */
+/*
+ * Hosts whose posted writes of a register address need a read back before
+ * the data port is used: the BCM4716 SoC with a PCIe radio, and the BCM63xx
+ * routers, where the stock driver reads back the PHY and radio address after
+ * every write of it. The check is compiled only there.
+ */
+static inline bool b43_flush_writes(struct b43_wldev *dev)
+{
+#if defined(CONFIG_BCM47XX_BCMA) || defined(CONFIG_BCM63XX)
+	return dev->dev->flush_writes;
+#else
+	return false;
+#endif
+}
+
 static inline void b43_write16f(struct b43_wldev *dev, u16 offset, u16 value)
 {
 	b43_write16(dev, offset, value);
-#if defined(CONFIG_BCM47XX_BCMA)
-	if (dev->dev->flush_writes)
+	if (b43_flush_writes(dev))
 		b43_read16(dev, offset);
-#endif
 }
 
 static inline void b43_maskset16(struct b43_wldev *dev, u16 offset, u16 mask,
diff --git a/drivers/net/wireless/broadcom/b43/bus.c b/drivers/net/wireless/broadcom/b43/bus.c
index fdb1c82..f4dedc1 100644
--- a/drivers/net/wireless/broadcom/b43/bus.c
+++ b/drivers/net/wireless/broadcom/b43/bus.c
@@ -99,6 +99,10 @@ struct b43_bus_dev *b43_bus_dev_bcma_init(struct bcma_device *core)
 	    bcm47xx_bus.bcma.bus.chipinfo.id == BCMA_CHIP_ID_BCM4716)
 		dev->flush_writes = true;
 #endif
+#ifdef CONFIG_BCM63XX
+	if (b43_bus_host_is_pci(dev))
+		dev->flush_writes = true;
+#endif
 
 	dev->dev = &core->dev;
 	dev->dma_dev = core->dma_dev;
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 8381f0f..418132d 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -510,6 +510,12 @@ static inline void b43_shm_control_word(struct b43_wldev *dev,
 	control <<= 16;
 	control |= offset;
 	b43_write32(dev, B43_MMIO_SHM_CONTROL, control);
+	/*
+	 * The AC cores' stock driver reads the object address back after every
+	 * write of it, on the x86 hybrid build as on the MIPS routers.
+	 */
+	if (dev->phy.type == B43_PHYTYPE_AC)
+		b43_read32(dev, B43_MMIO_SHM_CONTROL);
 }
 
 u32 b43_shm_read32(struct b43_wldev *dev, u16 routing, u16 offset)
diff --git a/drivers/net/wireless/broadcom/b43/phy_common.c b/drivers/net/wireless/broadcom/b43/phy_common.c
index 9674b94..f4713e6 100644
--- a/drivers/net/wireless/broadcom/b43/phy_common.c
+++ b/drivers/net/wireless/broadcom/b43/phy_common.c
@@ -222,7 +222,7 @@ u16 b43_radio_read(struct b43_wldev *dev, u16 reg)
 void b43_radio_write(struct b43_wldev *dev, u16 reg, u16 value)
 {
 	assert_mac_suspended(dev);
-	if (b43_bus_host_is_pci(dev->dev) &&
+	if (b43_bus_host_is_pci(dev->dev) && !b43_flush_writes(dev) &&
 	    ++dev->phy.writes_counter > B43_MAX_WRITES_IN_ROW) {
 		b43_read32(dev, B43_MMIO_MACCTL);
 		dev->phy.writes_counter = 1;
@@ -278,7 +278,7 @@ u16 b43_phy_read(struct b43_wldev *dev, u16 reg)
 void b43_phy_write(struct b43_wldev *dev, u16 reg, u16 value)
 {
 	assert_mac_suspended(dev);
-	if (b43_bus_host_is_pci(dev->dev) &&
+	if (b43_bus_host_is_pci(dev->dev) && !b43_flush_writes(dev) &&
 	    ++dev->phy.writes_counter > B43_MAX_WRITES_IN_ROW) {
 		b43_read16(dev, B43_MMIO_PHY_VER);
 		dev->phy.writes_counter = 1;
diff --git a/drivers/net/wireless/broadcom/b43/phy_common.h b/drivers/net/wireless/broadcom/b43/phy_common.h
index 4d48441..1293d55 100644
--- a/drivers/net/wireless/broadcom/b43/phy_common.h
+++ b/drivers/net/wireless/broadcom/b43/phy_common.h
@@ -33,7 +33,8 @@ struct b43_wldev;
 #define B43_PHYVER_TYPE_SHIFT		8
 #define B43_PHYVER_VERSION		0x00FF
 
-/* PHY writes need to be flushed if we reach limit */
+/* PHY writes need to be flushed if we reach limit, unless each address
+ * write is read back (b43_flush_writes()). */
 #define B43_MAX_WRITES_IN_ROW		24
 
 /**
-- 
2.43.0

